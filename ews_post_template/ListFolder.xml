        <t:RequestServerVersion Version="Exchange2013_SP1" />
    </soap:Header>
    <soap:Body>
        <FindFolder xmlns="http://schemas.microsoft.com/exchange/services/2006/messages" Traversal="Shallow">
            <FolderShape>
                <t:BaseShape>AllProperties</t:BaseShape>
            </FolderShape>
            <ParentFolderIds>
